[Unit]
Description=Study Platform private API
After=network-online.target
[Service]
User=study
Group=study
WorkingDirectory=/srv/study-platform/code
EnvironmentFile=/srv/study-platform/secrets.env
ExecStart=/srv/study-platform/venv/bin/python -m uvicorn backend.api.main:app --host 127.0.0.1 --port 8787
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/study-platform/private
[Install]
WantedBy=multi-user.target
